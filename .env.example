# Copiá este archivo a .env y completá con los datos de tu proyecto
# (Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Web Push (opcional): pisa la clave publica VAPID embebida en src/lib/push.js
# si algun dia rotas las claves (la privada vive en app_secrets, solo servidor).
# VITE_VAPID_PUBLIC_KEY=
